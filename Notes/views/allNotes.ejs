
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="/style.css">

    <title>My Notes</title>

</head>

<body>

    <nav class="navbar">

        <a href="/home" class="logo">
            Note<span>Space</span>
        </a>

        <a href="/createnotes" class="nav-link">
            + New Note
        </a>

    </nav>


    <main class="notes-page">

        <div class="notes-header">

            <div>

                <p class="tag">
                    ✦ YOUR COLLECTION
                </p>

                <h1>
                    All your
                    <span>notes.</span>
                </h1>

                <p>
                    Everything you've written, all in one place.
                </p>

            </div>


            <div class="note-count">

                <strong>03</strong>

                <span>NOTES</span>

            </div>

        </div>

            <% notes.forEach((note) => { %>

                <article class="note-card">

                    <div class="note-card-top">
                        <span>NOTE</span>
                    </div>

                    <h2>
                        <%= note.title %>
                    </h2>

                    <p>
                        <%= note.description %>
                    </p>

                    <div class="note-card-bottom">
                        <span>NOTE</span>
                        <button>→</button>
                    </div>

                </article>

            <% }) %>

            <!-- CREATE NEW NOTE -->

            <a href="/createnotes" class="add-note-card">

                <div class="plus">
                    +
                </div>

                <h2>
                    Create another note
                </h2>

                <p>
                    Got something new to write?
                </p>

            </a>


        </section>

    </main>

</body>

</html>