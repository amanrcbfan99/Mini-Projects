<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="/style.css">

    <title>NoteSpace</title>
</head>
<body>

    <nav class="navbar">
        <div class="logo">Note<span>Space</span></div>

        <a href="/allnotes" class="nav-link">My Notes →</a>
    </nav>


    <main class="home">

        <section class="hero">

            <div class="hero-content">

                <p class="tag">✦ YOUR PERSONAL NOTE SPACE</p>

                <h1>
                    Ideas deserve a
                    <span>place to stay.</span>
                </h1>

                <p class="hero-description">
                    Capture your thoughts, ideas and important moments
                    in one simple and beautiful place.
                </p>

                <div class="hero-buttons">

                    <a href="/createnotes" meth class="primary-btn">
                        Create a Note
                        <span>↗</span>
                    </a>

                    <a href="/allnotes" class="secondary-btn">
                        View All Notes
                    </a>

                </div>

            </div>


            <div class="hero-card">

                <div class="card-top">
                    <span class="small-label">LATEST NOTE</span>
                    <span class="dot">●</span>
                </div>

                <h2>
                    Things I want to learn
                </h2>

                <p>
                    Backend development, system design,
                    databases and building real-world projects...
                </p>

                <div class="card-footer">
                    <span>Oct 04, 2026</span>
                    <span>03 min read</span>
                </div>

            </div>

        </section>


        <section class="features">

            <div class="feature">
                <div class="feature-number">01</div>
                <h3>Write</h3>
                <p>Create notes whenever an idea comes to your mind.</p>
            </div>

            <div class="feature">
                <div class="feature-number">02</div>
                <h3>Organize</h3>
                <p>Keep all your thoughts together in one place.</p>
            </div>

            <div class="feature">
                <div class="feature-number">03</div>
                <h3>Remember</h3>
                <p>Come back anytime and revisit what you wrote.</p>
            </div>

        </section>

    </main>

</body>
</html>